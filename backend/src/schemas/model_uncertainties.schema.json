{
  "title": "Model Uncertainties Schema",
  "type": "object",
  "required": ["project_id", "formulation", "grid_connected"],
  "properties": {
    "project_id": { "type": "string" },
    "formulation": {
      "type": "string",
      "enum": ["linear", "expected_values", "icc", "jcc"]
    },
    "grid_connected": { "type": "boolean" },
    "grid_outage_settings": {
      "type": "object",
      "properties": {
        "availability_matrix": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            ".*": {
              "type": "array",
              "items": { "type": "number" }
            }
          }
        },
        "avg_outages_per_year": {
          "type": "number",
          "minimum": 0
        },
        "avg_outage_duration": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "forecast_errors": {
      "type": "object",
      "patternProperties": {
        "^(load|solar_pv|wind_turbine|mini_hydro)$": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            ".*": {
              "type": "array",
              "items": { "type": "number" }
            }
          }
        }
      }
    },
    "probabilistic_config": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["ICC", "JCC"] },
        "outage_duration": { "type": "number", "minimum": 0 },
        "outage_probability": {
          "type": "number", "minimum": 0, "maximum": 1
        },
        "islanding_probability": {
          "type": "number", "minimum": 0, "maximum": 1
        }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "formulation": { "const": "linear" } }
      },
      "then": {
        "required": ["project_id", "formulation", "grid_connected"]
      }
    },
    {
      "if": {
        "properties": { "formulation": { "enum": ["expected_values", "icc", "jcc"] } }
      },
      "then": {
        "required": ["forecast_errors"]
      }
    },
    {
      "if": {
        "properties": { "formulation": { "enum": ["icc", "jcc"] } }
      },
      "then": {
        "required": ["probabilistic_config"]
      }
    }
  ],
  "additionalProperties": false
}
