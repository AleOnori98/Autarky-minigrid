{
  "title": "Model Uncertainties Schema",
  "type": "object",
  "required": ["project_id", "formulation", "grid_connected"],
  "properties": {
    "project_id": { "type": "string" },
    "formulation": {
      "type": "string",
      "enum": ["linear", "expected_values", "icc", "jcc"]
    },
    "grid_connected": { "type": "boolean" },
    "grid_outage_settings": {
      "type": "object",
      "properties": {
        "availability_matrix": {
          "type": "object",
          "minProperties": 1,
          "patternProperties": {
            ".*": {
              "type": "array",
              "items": { "type": "number" }
            }
          }
        },
        "avg_outages_per_year": { "type": "number", "minimum": 0 },
        "avg_outage_duration": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "forecast_errors": {
      "type": "object",
      "properties": {
        "load": { "type": "boolean" },
        "load_errors": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "array",
                  "items": { "type": "number" }
                }
              }
            }
          }
        },
        "solar_pv": { "type": "boolean" },
        "solar_pv_errors": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "array",
                  "items": { "type": "number" }
                }
              }
            }
          }
        },
        "wind_turbine": { "type": "boolean" },
        "wind_turbine_errors": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "array",
                  "items": { "type": "number" }
                }
              }
            }
          }
        },
        "mini_hydro": { "type": "boolean" },
        "mini_hydro_errors": {
          "type": "object",
          "patternProperties": {
            ".*": {
              "type": "object",
              "patternProperties": {
                ".*": {
                  "type": "array",
                  "items": { "type": "number" }
                }
              }
            }
          }
        }
      }
    },
    "probabilistic_config": {
      "type": "object",
      "properties": {
        "outage_duration": { "type": "number", "minimum": 0 },
        "outage_probability": { "type": "number", "minimum": 0, "maximum": 1 },
        "islanding_probability": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "formulation": { "const": "linear" } } },
      "then": {
        "required": ["project_id", "formulation", "grid_connected"]
      }
    },
    {
      "if": { "properties": { "formulation": { "enum": ["expected_values"] } } },
      "then": {
        "required": ["forecast_errors"]
      }
    },
    {
      "if": { "properties": { "formulation": { "enum": ["icc", "jcc"] } } },
      "then": {
        "required": ["forecast_errors", "probabilistic_config"]
      }
    }
  ],
  "additionalProperties": false
}
